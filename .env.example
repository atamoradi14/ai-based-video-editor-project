# Copy to .env for Docker Compose. Do not commit the copy.
# gpt-6.1-luna is an illustrative model name. It is not assumed to exist.
# Leave AI_PROVIDER=fixture to run the offline planner with real FFmpeg edits.

ASPNETCORE_ENVIRONMENT=Development
NEXT_PUBLIC_API_URL=http://localhost:8080
API_PORT=8080
WEB_PORT=3410

AI_PROVIDER=fixture
AI_MODEL=gpt-6.1-luna
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=180
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_TOOL_CALLS=40
AI_MAX_RETRIES=3
AI_VISION_MODEL=
AI_IMAGE_PROVIDER=
AI_IMAGE_MODEL=
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=
AI_TRANSCRIPTION_PROVIDER=local
AI_TRANSCRIPTION_MODEL=

DATABASE_URL=
DATABASE_PROVIDER=Sqlite
SQLITE_PATH=data/dev.db
REDIS_URL=
STORAGE_PROVIDER=local
STORAGE_PATH=data/storage
AZURE_STORAGE_CONTAINER=ai-content
AZURE_STORAGE_CONNECTION_STRING=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

ENGINE_BASE_URL=http://127.0.0.1:32147
ENGINE_INTERNAL_TOKEN=
ENGINE_DATA_ROOT=
JWT_SIGNING_KEY=
JWT_ISSUER=ai-content
SEED_DEMO_USER=true
DEMO_EMAIL=demo@lumen.studio
DEMO_PASSWORD=Demo-Studio-1
PUBLIC_API_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:3410,http://localhost:3000
RUN_WORKER_IN_API=true
UPLOAD_MAX_BYTES=536870912

DOCKERHUB_USERNAME=
DOCKERHUB_IMAGE_PREFIX=ai-content
K8S_NAMESPACE=ai-content
K8S_CONTEXT=
K8S_INGRESS_HOST=
K8S_TLS_SECRET=ai-content-tls
